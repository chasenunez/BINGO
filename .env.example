# RDM Bingo configuration template.
#
# Copy to .env and fill in real values:
#     cp .env.example .env
#
# .env is git-ignored and must never be committed. Keep a copy of the secrets
# somewhere safe: SECRET_KEY is the ONLY way to decrypt the data file, and
# losing it means losing every account and board permanently.
#
# Generate a value for any of the secrets below with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# --- Required ---------------------------------------------------------------

# Encrypts the data file (AES-256-GCM). Minimum 32 characters. Changing this
# on an existing deployment makes the existing data file unreadable.
SECRET_KEY=

# --- Strongly recommended ---------------------------------------------------

# Signs session cookies. Without it a random value is generated at startup,
# which logs every user out on each restart, including every redeploy.
SESSION_SECRET=

# Bearer token for the admin API used by scripts/admin.js and
# scripts/retention.js. Admin endpoints return 503 while this is unset.
ADMIN_TOKEN=

# --- Deployment settings ----------------------------------------------------

# URL prefix the app is mounted under. Empty means served at the site root.
# Example: BASE_PATH=/bingo serves it at https://example.org/bingo/
BASE_PATH=

# Set to true when a reverse proxy terminates HTTPS in front of the app. Flags
# session cookies Secure and enables HSTS. Leave empty for local HTTP testing.
COOKIE_SECURE=

# Number of reverse-proxy hops to trust for X-Forwarded-* headers. 1 for a
# single proxy, 2 if a load balancer sits in front of that. Defaults to 1
# whenever BASE_PATH or COOKIE_SECURE is set.
TRUST_PROXY=

# --- Container-only settings ------------------------------------------------

# Host port the container is published on (container side is always 3000).
HOST_PORT=3000

# Tag applied to the built image. Use a version or date for archived builds,
# e.g. IMAGE_TAG=2026-08-31.
IMAGE_TAG=local

# Where the encrypted store lives. Inside the container this is set by
# docker-compose.yml to /data/store.json.enc and should not be changed here.
# Outside a container it defaults to ./data/store.json.enc.
# STORE_FILE_PATH=
